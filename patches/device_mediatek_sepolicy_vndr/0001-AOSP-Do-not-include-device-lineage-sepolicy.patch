Subject: [PATCH] AOSP: Do not include device/lineage/sepolicy

Change-Id: Ieb4dfffe38ea8811401a976ee9b61703a4987141
---
 SEPolicy.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/SEPolicy.mk b/SEPolicy.mk
index f57bfc1..c187092 100644
--- a/SEPolicy.mk
+++ b/SEPolicy.mk
@@ -2,7 +2,7 @@
 MTK_SEPOLICY_PATH := device/mediatek/sepolicy_vndr
 TRUSTY_DEVICE_PATH := device/generic/trusty
 
-include device/lineage/sepolicy/libperfmgr/sepolicy.mk
+# AOSP: libperfmgr policy is carried by the device tree (was device/lineage/sepolicy/libperfmgr)
 
 BOARD_VENDOR_SEPOLICY_DIRS += $(MTK_SEPOLICY_PATH)/base/vendor
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(MTK_SEPOLICY_PATH)/base/private
